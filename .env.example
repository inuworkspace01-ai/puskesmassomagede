# Generate a long secret: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Store only bcrypt hashes, never plaintext passwords.
SUPERADMIN_EMAIL=superadmin@puskesmas.local
SUPERADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
ADMIN_EMAIL=admin@puskesmas.local
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
STAF_EMAIL=informasi@puskesmas.local
STAF_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
